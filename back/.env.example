# Database: sqlite (default) or postgresql
DB_ENGINE=sqlite

# PostgreSQL (when DB_ENGINE=postgresql)
DB_NAME=sportz
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Security
SECRET_KEY=change-me-in-production
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=30

# MongoDB — in-app notifications (NoSQL activity feed)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sportz
NOTIFICATIONS_USE_MONGO=true

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
